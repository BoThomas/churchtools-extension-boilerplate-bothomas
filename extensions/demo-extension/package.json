    "@churchtools-extensions/shared-styles": "workspace:*",
    "@churchtools/churchtools-client": "^1.4.2",
    "@primevue/icons": "^4.3.9",
    "@tailwindcss/vite": "^4.1.13",
    "pinia": "^3.0.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.9",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.22"
  }
