    "@churchtools-extensions/shared-styles": "workspace:*",
    "@churchtools/churchtools-client": "^1.7.3",
    "@primevue/icons": "^4.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.44"
  }
