{
  "name": "ct-demo-extension",
  "private": true,
  "version": "0.1.0",
  "description": "Small demo ChurchTools extension for the boilerplate",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BoThomas/churchtools-extension-boilerplate-bothomas"
  },
  "author": {
